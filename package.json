{
  "name": "arbor-harness",
  "version": "0.1.0",
  "private": true,
  "description": "An extensible runtime for coding agents.",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "arbor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "15.1.0",
    "eventsource-parser": "4.1.3",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
